{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production*)",
      "Read(**/.env.development*)",
      "Read(**/.env.staging*)",
      "Read(**/.env.test*)",
      "Read(**/.mcp.json)",
      "Read(**/.infisical.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)"
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  }
}
